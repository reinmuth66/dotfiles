{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [-100, -100],
  "toast": "quiet-toast",
  "theme": "catppuccin-macchiato",
  "window_blur": true,
  "colors": {
    "canvas": "#24273ab3",
    "chrome": "#1e2030b3"
  },
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "floating": [
    {
      "id": "resize-mode",
      "content": { "mod": "resize-mode" },
      "edge": "top",
      "align": "end"
    }
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 240 },
      "min": 160,
      "max": 480,
      "background": "chrome",
      "divider": { "width": 1, "color": "border" },
      "children": [
        {
          "id": "usage",
          "type": "block",
          "window_drag": true,
          "size": { "px": 72 },
          "content": { "mod": "usage" }
        },
        {
          "id": "workspace",
          "type": "block",
          "size": { "weight": 1 },
          "min": 90,
          "content": { "mod": "workspace" }
        },
        {
          "id": "tree",
          "type": "block",
          "size": { "weight": 1 },
          "min": 90,
          "content": { "mod": "tree" }
        }
      ]
    },
    {
      "id": "preview-area",
      "type": "stack",
      "active": "preview",
      "size": { "px": 480 },
      "min": 160,
      "max": 900,
      "children": [
        {
          "id": "preview",
          "type": "block",
          "content": { "mod": "preview" }
        }
      ]
    },
    {
      "id": "agent-area",
      "type": "block",
      "min": 320,
      "padding": 8,
      "content": {
        "tab": "active",
        "pane": {
          "gap": 8,
          "radius": 10,
          "background": "background",
          "lone": true,
          "border": { "width": 1, "color": "border" },
          "focus": { "width": 1, "color": "accent" },
          "header": {
            "content": { "mod": "pane" },
            "height": 30,
            "position": "top",
            "reveal": "always"
          }
        }
      }
    }
  ]
}
