{
  "global": {
    "cmd-q": "app.quit",
    "cmd-h": "app.hide",
    "cmd-alt-h": "app.hide_others",
    "cmd-m": "window.minimize",
    "cmd-t": "tab.new",
    "cmd-w": "tab.close",
    "ctrl-tab": "tab.next",
    "ctrl-shift-tab": "tab.prev",
    "cmd-shift-]": "tab.next",
    "cmd-shift-[": "tab.prev",
    "cmd-alt-]": "space.next",
    "cmd-alt-[": "space.prev",
    "cmd-]": "agent.next",
    "cmd-[": "agent.prev",
