+
+// The playback progress (0..1) is kept in its own file, $CAVAVIZ_PROGRESS, as one decimal number, because the
+// control file holds only the last command (a "progress" written right after a "show" would hide the "show").
+// The file is checked once per frame (when its mtime changed) and is exposed to the shader as
+//   uniform float viz_progress;
+// A change draws once even if the bars are not moving (silence), so the colours follow the playback position.
+static float viz_progress = 0.0f;
+static int viz_progress_dirty = 0;
+static struct timespec viz_progress_mtime;
 
+static void viz_poll_progress(void) {
+    const char *path = getenv("CAVAVIZ_PROGRESS");
+    struct stat st;
+    if (path == NULL || stat(path, &st) != 0)
+        return;
+    if (st.st_mtimespec.tv_sec == viz_progress_mtime.tv_sec &&
+        st.st_mtimespec.tv_nsec == viz_progress_mtime.tv_nsec)
+        return;
+    viz_progress_mtime = st.st_mtimespec;
+
+    FILE *f = fopen(path, "r");
+    if (f == NULL)
+        return;
+    double value = 0;
+    int n = fscanf(f, "%lf", &value);
+    fclose(f);
+    if (n != 1)
+        return;
+    viz_progress = (float)(value < 0 ? 0 : (value > 1 ? 1 : value));
+    viz_progress_dirty = 1;
+}
+
 static void viz_poll_control(void) {
     viz_signal_ready();
+    viz_poll_progress();
     const char *path = getenv("CAVAVIZ_CONTROL");
     struct stat st;
