+// The playback progress (0..1) is kept in its own file, $CAVAVIZ_PROGRESS, because the control file holds only
+// the last command (a "progress" written right after a "show" would hide the "show"). The file holds
+//   "P RATE"
+// where P is the progress at the moment the file was last modified (its mtime is the time base) and RATE is the
+// speed in progress per second (0 while paused). cava advances the progress by itself from that, so the writer
+// only has to write when the position jumps or playback starts or stops, not every second.
+// The file is checked once per frame (stat) and the value is exposed to the shader as
+//   uniform float viz_progress;
+// A change draws once even if the bars are not moving (silence), so the colours follow the playback position.
+static float viz_progress = 0.0f;
+static int viz_progress_dirty = 0;
+static struct timespec viz_progress_mtime;
+static double viz_progress_base = 0.0;
+static double viz_progress_rate = 0.0;
 
+static void viz_poll_progress(void) {
+    const char *path = getenv("CAVAVIZ_PROGRESS");
+    struct stat st;
+    if (path == NULL || stat(path, &st) != 0)
+        return;
+    int rebased = 0;
+    if (st.st_mtimespec.tv_sec != viz_progress_mtime.tv_sec ||
+        st.st_mtimespec.tv_nsec != viz_progress_mtime.tv_nsec) {
+        FILE *f = fopen(path, "r");
+        if (f == NULL)
+            return;
+        double base = 0, rate = 0;
+        int n = fscanf(f, "%lf %lf", &base, &rate);
+        fclose(f);
+        // An empty file is a write in progress: keep the old mtime so that the next frame reads it again.
+        if (n < 1)
+            return;
+        viz_progress_mtime = st.st_mtimespec;
+        viz_progress_base = base < 0 ? 0 : (base > 1 ? 1 : base);
+        viz_progress_rate = (n == 2 && rate > 0) ? rate : 0;
+        rebased = 1;
+    }
+
+    double value = viz_progress_base;
+    if (viz_progress_rate > 0) {
+        struct timespec now;
+        clock_gettime(CLOCK_REALTIME, &now);
+        double elapsed = (double)(now.tv_sec - viz_progress_mtime.tv_sec) +
+                         (double)(now.tv_nsec - viz_progress_mtime.tv_nsec) * 1e-9;
+        value += viz_progress_rate * (elapsed < 0 ? 0 : elapsed);
+        value = value > 1 ? 1 : value;
+    }
+    // Redraw only when the colour boundary moves by a visible amount (about 0.1 px of the 222 px bar area).
+    if (rebased || fabs(value - (double)viz_progress) >= 0.0005) {
+        viz_progress = (float)value;
+        viz_progress_dirty = 1;
+    }
+}
