+// Audio gate. $CAVAVIZ_AUDIO is a file that holds "on" or "off". While it says "off" there is no tap at all, so
+// the system does not record audio (the recording indicator is off) and the bars fall to zero. It is checked
+// every 100 ms. Without the variable, or with a missing file, the tap is always on, as in plain cava.
+// Starting with "off" must not touch the audio hardware either, so the format that cava needs at start-up is
+// taken from the default output device (a stereo float tap at its sample rate, which is what the tap gives).
+static bool gate_wants_on(void) {
+    const char *path = getenv("CAVAVIZ_AUDIO");
+    if (path == NULL) {
+        return true;
+    }
+    FILE *f = fopen(path, "r");
+    if (f == NULL) {
+        return true;
+    }
+    char word[8] = "";
+    if (fscanf(f, "%7s", word) != 1) {
+        word[0] = '\0';
+    }
+    fclose(f);
+    return strcmp(word, "off") != 0;
+}
 
+static void set_default_format(struct audio_data *audio) {
+    audio->rate = 48000;
+    AudioObjectPropertyAddress address = {
+        kAudioHardwarePropertyDefaultOutputDevice,
+        kAudioObjectPropertyScopeGlobal,
+        kAudioObjectPropertyElementMain,
+    };
+    AudioObjectID device = kAudioObjectUnknown;
+    UInt32 size = sizeof(device);
+    Float64 rate = 0;
+    if (AudioObjectGetPropertyData(kAudioObjectSystemObject, &address, 0, NULL, &size, &device) ==
+            noErr &&
+        device != kAudioObjectUnknown && get_device_nominal_rate(device, &rate) == noErr &&
+        rate > 0) {
+        audio->rate = (unsigned int)rate;
+    }
+    audio->channels = 2;
+    audio->format = 32;
+    audio->IEEE_FLOAT = 1;
+}
+
+// Read the format of the tap into audio. After the first open cava has built its filters for that format, so a
+// later open must give the same channels and sample format; the sample rate is left as it was.
+static bool tap_setup_format(struct tap_state *state) {
+    struct audio_data *audio = state->audio;
+    __typeof__(audio->rate) rate = audio->rate;
+    __typeof__(audio->channels) channels = audio->channels;
+    __typeof__(audio->format) format = audio->format;
+    __typeof__(audio->IEEE_FLOAT) ieee = audio->IEEE_FLOAT;
+
+    bool ok = setup_audio_format_from_device(state);
+    if (ok && state->format_locked) {
+        bool same = audio->channels == channels && audio->format == format && audio->IEEE_FLOAT == ieee;
+        audio->rate = rate;
+        if (!same) {
+            audio->channels = channels;
+            audio->format = format;
+            audio->IEEE_FLOAT = ieee;
+            fprintf(stderr, "Error: the tap format changed since start-up; the tap stays off\n");
+            ok = false;
+        }
+    }
+    return ok;
+}
