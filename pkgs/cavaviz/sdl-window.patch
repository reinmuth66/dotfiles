+#ifdef __APPLE__
+// Move the window with a control file instead of restarting cava (a restart takes ~0.35 s and the bars vanish meanwhile).
+// The path is in $CAVAVIZ_CONTROL and the file is checked once per frame (when its mtime changed):
+//   "show X Y"  move the window to (X, Y) and draw again
+//   "hide"      move the window off the screen and stop drawing (the audio tap and the FFT keep running)
+static int viz_hidden = 0;
+static struct timespec viz_control_mtime;
+
+// Tell the launcher that cava is initialised (the FFT plan and the window exist) by running
+//   $CAVAVIZ_READY_BIN --trigger $CAVAVIZ_READY_EVENT ID=$CAVAVIZ_READY_ID
+// (sketchybar's own CLI, so the launcher gets an event). This is the first thing the draw loop does, so a
+// "show" sent after this appears at once. The child is not waited for (it takes ~10-20 ms); it is reaped
+// on a later poll.
+extern char **environ;
+static pid_t viz_ready_pid = 0;
+
+static void viz_signal_ready(void) {
+    static int done = 0;
+    if (!done) {
+        done = 1;
+        const char *bin = getenv("CAVAVIZ_READY_BIN");
+        const char *event = getenv("CAVAVIZ_READY_EVENT");
+        const char *id = getenv("CAVAVIZ_READY_ID");
+        if (bin != NULL && bin[0] != '\0' && event != NULL) {
+            char arg[64];
+            snprintf(arg, sizeof arg, "ID=%s", id != NULL ? id : "");
+            char *argv[] = {(char *)bin, "--trigger", (char *)event, arg, NULL};
+            if (posix_spawn(&viz_ready_pid, bin, NULL, NULL, argv, environ) != 0)
+                viz_ready_pid = 0;
+        }
+    } else if (viz_ready_pid > 0 && waitpid(viz_ready_pid, NULL, WNOHANG) == viz_ready_pid) {
+        viz_ready_pid = 0;
+    }
+}
+
+static void viz_poll_control(void) {
+    viz_signal_ready();
+    const char *path = getenv("CAVAVIZ_CONTROL");
+    struct stat st;
+    if (path == NULL || stat(path, &st) != 0)
+        return;
+    if (st.st_mtimespec.tv_sec == viz_control_mtime.tv_sec &&
+        st.st_mtimespec.tv_nsec == viz_control_mtime.tv_nsec)
+        return;
+    viz_control_mtime = st.st_mtimespec;
+
+    FILE *f = fopen(path, "r");
+    if (f == NULL)
+        return;
+    char cmd[16] = "";
+    int x = 0, y = 0;
+    int n = fscanf(f, "%15s %d %d", cmd, &x, &y);
+    fclose(f);
+
+    // Hide by making the window transparent, and do NOT move it: a move right after the opacity change makes
+    // both reach the screen together, ~23 ms later (a plain transparent hide: ~14 ms; the popup under the
+    // window closes in ~15 ms, so they vanish together). The transparent window stays where it is, ignoring the
+    // mouse, until the process is stopped. Show: move to the slot, then make it opaque (~16 ms).
+    if (n >= 1 && strcmp(cmd, "hide") == 0) {
+        SDL_SetWindowOpacity(glWindow, 0.0f);
+        viz_hidden = 1;
+    } else if (n == 3 && strcmp(cmd, "show") == 0) {
+        SDL_SetWindowPosition(glWindow, x, y);
+        SDL_SetWindowOpacity(glWindow, 1.0f);
+        viz_hidden = 0;
+    }
+}
+
+static int viz_kq = -1;
+
+// Frame wait: sleep for up to `total` ms, but wake at once when the control file is written, and apply the
+// command. Used instead of SDL_Delay so that a "show" and a "hide" take effect at once instead of at the
+// next frame (a "hide" matters when the popup under the window disappears). Waiting is done with kqueue on
+// the control file, without polling.
+static void viz_sleep(int total) {
+    const char *path = getenv("CAVAVIZ_CONTROL");
+    if (viz_kq < 0 && path != NULL) {
+        int fd = open(path, O_EVTONLY);
+        if (fd >= 0) {
+            viz_kq = kqueue();
+            struct kevent ev;
+            EV_SET(&ev, fd, EVFILT_VNODE, EV_ADD | EV_CLEAR,
+                   NOTE_WRITE | NOTE_EXTEND | NOTE_ATTRIB | NOTE_DELETE | NOTE_RENAME, 0, NULL);
+            kevent(viz_kq, &ev, 1, NULL, 0, NULL);
+        }
+    }
+    if (viz_kq < 0) {
+        SDL_Delay(total); // no control file to watch: a plain slow frame
+        return;
+    }
+    struct kevent out;
+    struct timespec timeout = {total / 1000, (total % 1000) * 1000000L};
+    kevent(viz_kq, NULL, 0, &out, 1, &timeout); // returns at once when the control file is written
+    viz_poll_control();
+}
