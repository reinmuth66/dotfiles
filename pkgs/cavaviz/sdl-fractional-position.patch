+// The NSWindow of the SDL window. SDL_SetWindowPosition takes whole points only, but the popup under the window
+// can sit at a half-point position (and the Retina drawable can show it), so the window is placed through
+// NSWindow with fractional coordinates.
+static id viz_nswindow = NULL;
+
+// Move the window so that its top left corner is at (x, y), in points from the top left corner of the primary
+// display (the coordinates of sketchybar --query). Cocoa counts y from the bottom left corner of the primary display.
+static void viz_move_window(double x, double y) {
+    if (viz_nswindow == NULL)
+        return;
+    id screens = MSG0((id)objc_getClass("NSScreen"), "screens");
+    id primary = ((id (*)(id, SEL, unsigned long))objc_msgSend)(screens, sel_registerName("objectAtIndex:"), 0);
+    CGRect screen_frame = ((CGRect (*)(id, SEL))objc_msgSend)(primary, sel_registerName("frame"));
+    CGRect window_frame = ((CGRect (*)(id, SEL))objc_msgSend)(viz_nswindow, sel_registerName("frame"));
+    CGPoint origin = CGPointMake(x, screen_frame.size.height - y - window_frame.size.height);
+    ((void (*)(id, SEL, CGPoint))objc_msgSend)(viz_nswindow, sel_registerName("setFrameOrigin:"), origin);
+}
